{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitalengagementlab.com/schemas/oel-spacecraft-power-v1.schema.json",
  "title": "OEL Spacecraft Power Records v1",
  "oneOf": [
    {"$ref": "#/$defs/problem"},
    {"$ref": "#/$defs/history"},
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/manifest"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "quaternion": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "number"}
    },
    "solarArray": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area_m2", "efficiency", "solar_flux_w_m2", "maximum_generation_w", "normal_body"],
      "properties": {
        "area_m2": {"type": "number", "exclusiveMinimum": 0},
        "efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "solar_flux_w_m2": {"type": "number", "exclusiveMinimum": 0},
        "maximum_generation_w": {"type": "number", "exclusiveMinimum": 0},
        "normal_body": {"$ref": "#/$defs/vector3"}
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capacity_wh", "initial_soc_fraction", "minimum_soc_fraction", "maximum_soc_fraction",
        "maximum_charge_power_w", "maximum_discharge_power_w", "charge_efficiency", "discharge_efficiency"
      ],
      "properties": {
        "capacity_wh": {"type": "number", "exclusiveMinimum": 0},
        "initial_soc_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_soc_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_soc_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_charge_power_w": {"type": "number", "exclusiveMinimum": 0},
        "maximum_discharge_power_w": {"type": "number", "exclusiveMinimum": 0},
        "charge_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "discharge_efficiency": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_id", "category", "start_s", "end_s", "load_power_w", "source_product_sha256"],
      "properties": {
        "activity_id": {"$ref": "#/$defs/nonempty"},
        "category": {"$ref": "#/$defs/nonempty"},
        "start_s": {"type": "number"},
        "end_s": {"type": "number"},
        "load_power_w": {"type": "number", "minimum": 0},
        "source_product_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "analysis_id", "asset_id", "epoch_jd_utc", "horizon_start_s",
        "horizon_end_s", "integration_step_s", "transition_time_tolerance_s",
        "transition_max_iterations", "shadow_model", "ephemeris_model", "orientation_mode",
        "solar_array", "battery", "base_load_w", "activities"
      ],
      "properties": {
        "schema_version": {"const": "oel.spacecraft_power_problem.v1"},
        "analysis_id": {"$ref": "#/$defs/nonempty"},
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "epoch_jd_utc": {"type": "number"},
        "horizon_start_s": {"type": "number"},
        "horizon_end_s": {"type": "number"},
        "integration_step_s": {"type": "number", "exclusiveMinimum": 0, "maximum": 60},
        "transition_time_tolerance_s": {"type": "number", "exclusiveMinimum": 0},
        "transition_max_iterations": {"type": "integer", "minimum": 1},
        "shadow_model": {"enum": ["conical", "cylindrical", "none"]},
        "ephemeris_model": {"enum": ["analytic_simple", "analytic_enhanced"]},
        "orientation_mode": {"enum": ["sun_tracking_ideal", "history_body_fixed"]},
        "solar_array": {"$ref": "#/$defs/solarArray"},
        "battery": {"$ref": "#/$defs/battery"},
        "base_load_w": {"type": "number", "minimum": 0},
        "activities": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/activity"}
        }
      }
    },
    "historySample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_s", "position_eci_km", "velocity_eci_km_s", "attitude_quat_bn"],
      "properties": {
        "time_s": {"type": "number"},
        "position_eci_km": {"$ref": "#/$defs/vector3"},
        "velocity_eci_km_s": {"$ref": "#/$defs/vector3"},
        "attitude_quat_bn": {
          "oneOf": [{"$ref": "#/$defs/quaternion"}, {"type": "null"}]
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "asset_id", "epoch_jd_utc", "frame", "product_kind",
        "state_provider_id", "attitude_source_kind", "attitude_provider_id",
        "refinement_source", "samples"
      ],
      "properties": {
        "schema_version": {"const": "oel.spacecraft_power_history.v1"},
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "epoch_jd_utc": {"type": "number"},
        "frame": {"const": "eci"},
        "product_kind": {"$ref": "#/$defs/nonempty"},
        "state_provider_id": {"$ref": "#/$defs/nonempty"},
        "attitude_source_kind": {"enum": ["achieved", "replay", "analytic_ideal", "not_required"]},
        "attitude_provider_id": {
          "oneOf": [{"$ref": "#/$defs/nonempty"}, {"type": "null"}]
        },
        "refinement_source": {"$ref": "#/$defs/nonempty"},
        "samples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 200000,
          "items": {"$ref": "#/$defs/historySample"}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_energy_wh", "load_energy_wh", "served_load_energy_wh", "unmet_load_energy_wh",
        "curtailed_energy_wh", "charged_battery_energy_wh", "discharged_battery_energy_wh"
      ],
      "properties": {
        "generated_energy_wh": {"type": "number"},
        "load_energy_wh": {"type": "number"},
        "served_load_energy_wh": {"type": "number"},
        "unmet_load_energy_wh": {"type": "number"},
        "curtailed_energy_wh": {"type": "number"},
        "charged_battery_energy_wh": {"type": "number"},
        "discharged_battery_energy_wh": {"type": "number"}
      }
    },
    "batterySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_energy_wh", "final_energy_wh", "initial_soc_fraction", "final_soc_fraction",
        "minimum_soc_fraction", "maximum_soc_fraction", "minimum_soc_margin_fraction"
      ],
      "properties": {
        "initial_energy_wh": {"type": "number"},
        "final_energy_wh": {"type": "number"},
        "initial_soc_fraction": {"type": "number"},
        "final_soc_fraction": {"type": "number"},
        "minimum_soc_fraction": {"type": "number"},
        "maximum_soc_fraction": {"type": "number"},
        "minimum_soc_margin_fraction": {"type": "number"}
      }
    },
    "residuals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["battery_storage", "power_bus", "load_service"],
      "properties": {
        "battery_storage": {"type": "number"},
        "power_bus": {"type": "number"},
        "load_service": {"type": "number"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "analysis_id", "asset_id", "status", "feasibility", "model",
        "problem_semantic_sha256", "history_semantic_sha256", "result_semantic_sha256",
        "sample_count", "illumination_interval_count", "event_count", "totals", "battery",
        "conservation_residuals_wh", "source_product_sha256s", "claim_limits"
      ],
      "properties": {
        "schema_version": {"const": "oel.spacecraft_power_evidence.v1"},
        "analysis_id": {"$ref": "#/$defs/nonempty"},
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "status": {"const": "completed"},
        "feasibility": {"enum": ["feasible", "infeasible"]},
        "model": {"const": "deterministic_sampled_solar_array_battery_v1"},
        "problem_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "history_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "result_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "sample_count": {"type": "integer", "minimum": 2, "maximum": 200000},
        "illumination_interval_count": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 0},
        "totals": {"$ref": "#/$defs/totals"},
        "battery": {"$ref": "#/$defs/batterySummary"},
        "conservation_residuals_wh": {"$ref": "#/$defs/residuals"},
        "source_product_sha256s": {
          "type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}
        },
        "claim_limits": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "enum": [
            "normalized_problem.json", "normalized_history.json", "spacecraft_power_summary.json",
            "spacecraft_power_timeseries.csv", "spacecraft_power_intervals.csv", "spacecraft_power_events.csv"
          ]
        },
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "analysis_id", "asset_id", "status", "feasibility",
        "problem_semantic_sha256", "history_semantic_sha256", "result_semantic_sha256",
        "artifacts", "claim_limits"
      ],
      "properties": {
        "schema_version": {"const": "oel.spacecraft_power_manifest.v1"},
        "analysis_id": {"$ref": "#/$defs/nonempty"},
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "status": {"const": "completed"},
        "feasibility": {"enum": ["feasible", "infeasible"]},
        "problem_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "history_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "result_semantic_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {
          "type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/receipt"}
        },
        "claim_limits": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    }
  }
}
