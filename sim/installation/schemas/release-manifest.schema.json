{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oel.example/schemas/release-manifest.schema.json",
  "title": "OEL Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "edition", "version", "channel", "published_at", "artifacts", "platforms", "python", "profiles", "contracts"],
  "properties": {
    "schema_version": {"const": "oel.release-manifest.v1"},
    "product": {"const": "orbital-engagement-lab"},
    "edition": {"enum": ["public", "pro"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][0-9A-Za-z.-]+)?$"},
    "source_commit": {"type": ["string", "null"]},
    "channel": {"enum": ["stable", "preview"]},
    "published_at": {"type": "string", "format": "date-time"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "bytes", "sha256"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "url": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string"},
          "platform": {"type": "string"},
          "architecture": {"type": "string"}
        },
        "anyOf": [{"required": ["path"]}, {"required": ["url"]}]
      }
    },
    "platforms": {"type": "array", "items": {"type": "string"}},
    "architecture": {"type": "string", "minLength": 1},
    "python": {"type": "object"},
    "profiles": {"type": "array", "items": {"type": "string"}},
    "contracts": {"type": "object"},
    "constraints": {"type": "object"},
    "minimum_launcher_version": {"type": "string"},
    "release_notes": {"type": "string"},
    "claims": {"type": "array", "items": {"type": "string"}},
    "non_claims": {"type": "array", "items": {"type": "string"}},
    "license": {"type": "object"},
    "supply_chain": {"type": "object"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "value"],
      "properties": {
        "alg": {"const": "RS256"},
        "key_id": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      }
    }
  }
}
