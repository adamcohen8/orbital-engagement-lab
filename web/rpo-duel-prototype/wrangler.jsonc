{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oel-rpo-duel",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DUEL_ROOMS",
        "class_name": "RpoDuelRoom"
      }
    ]
  },
  "exports": {
    "RpoDuelRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
